{
  "name": "cap2ui5-samples",
  "private": true,
  "description": "The abap2UI5 samples as cap2UI5 apps: plain JavaScript classes in a CAP project, views built with ViewBuilder.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds": "^10",
    "cap2ui5": "^0.2.0"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "fast-xml-parser": "^5.11.1"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "node --test test/*.test.mjs"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      }
    }
  }
}
